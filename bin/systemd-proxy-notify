#!/usr/bin/env python3

import argparse
import os
import shutil
import subprocess
from subprocess import Popen, TimeoutExpired
import sys
import time

# "Configuration error".
# This is what we exit with if the service process exits too early.
# It exiting too early probably does mean you configured it wrong!
# It's the closest we could find aside from EXIT_FAILURE.
# https://www.freedesktop.org/software/systemd/man/latest/systemd.exec.html#Process%20Exit%20Codes
EX_CONFIG = 78

SYSTEMD_NOTIFY = os.environ.get('SYSTEMD_NOTIFY', shutil.which('systemd-notify'))

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--timeout-sec', type=float, default=1.0,
        help="If the process exits before this time, it's considered failed",
    )
    parser.add_argument('--detach', dest='detach', action='store_true', default=True,
    )
    parser.add_argument('--no-detach', dest='detach', action='store_false', default=True)
    parser.add_argument('command', nargs=argparse.REMAINDER, type=str)
    args = parser.parse_args()

    if SYSTEMD_NOTIFY is None:
        raise FileNotFoundError('systemd-notify')

    command = args.command

    subprocess.check_call(
        [SYSTEMD_NOTIFY, '--status=starting'],
    )

    process = Popen(
        args.command,
        start_new_session=args.detach,
    )
    print(f"notify-shim: process started: {process.pid}", file=sys.stderr)

    subprocess.check_call(
        [SYSTEMD_NOTIFY, f"--status=Process started: {process.pid}"],
    )

    if args.timeout_sec:
        try:
            rtn = process.wait(timeout=args.timeout_sec)
            # This is the bad case.
            # Log, though exit with our own return code.
            print(f"notify-shim: process exited early with return code '{rtn}'", file=sys.stderr)
            sys.exit(78)
        except TimeoutExpired:
            # Counterintuitively, this is our success case.
            # If waiting timed out, then the process has not exited and we should assume it's doing fine.
            pass

    subprocess.check_call(
        [SYSTEMD_NOTIFY, f'--ready'],
    )
    print(f"notify-shim: timeout passed, process is considered ready", file=sys.stderr)

    if args.detach:
        subprocess.check_call([SYSTEMD_NOTIFY, f'--pid={process.pid}'])

    # We're done!

    if args.detach:
        sys.exit(0)

    # If we're not detaching, wait until the service process ends and forward
    # its return code.
    rtn = process.wait()
    sys.exit(rtn)

if __name__ == '__main__':
    main()
